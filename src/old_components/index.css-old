.card{
    border: 1px solid black;
    border-radius: 10px;
    box-shadow: 5px 5px 5px green;
    padding: 30px;
    margin: 10px ;
    text-align: center;
    max-width: 250px;
    display: inline-block;

}

.card .card-image{
    max-width: 60%;
    height: auto;
    margin-bottom: 10px;

}

.card .card-title{
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif    ;
    margin: 0;
    color: blueviolet;

}

.card .card-text{
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    color: aqua;
    
}